# Everything ignored by default
*

# Public-facing package and release metadata
!.gitignore
!LICENSE
!README.md
!CHANGELOG.md
!CITATION.cff
!pyproject.toml
!.github/
!.github/release.yml
!.github/workflows/
!.github/workflows/ci.yml
!src/
!src/edgemap/
!src/edgemap/**

# Quickstart example
!quickstart/
!quickstart/README.md
!quickstart/run_quickstart.py
!quickstart/output/
!quickstart/output/results.json
!quickstart/output/lr_pair_stats.json

# Test suite
!tests/
!tests/**

# Publication audit and reproducibility contract. This directory contains
# documentation and manifests only; analysis code and frozen outputs are
# admitted individually after the release checks described there pass.
!reproducibility/
!reproducibility/README.md
!reproducibility/PUBLICATION_MANIFEST.csv
!reproducibility/EXCLUSION_REGISTER.md
!reproducibility/RELEASE_CHECKLIST.md
!reproducibility/ED_FIGURE_AUDIT.md

# Exclude generated Python/build artifacts after package and test un-ignores.
**/__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
